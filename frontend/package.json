{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"knip": "knip",
		"format": "prettier --write .",
		"kysely": "kysely-codegen --out-file ./src/lib/server/db_types.d.ts",
		"protoc": "protoc --ts_proto_out=./src/lib/server/grpc/proto --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false  -I /workspaces/grpc worker.proto clip.proto",
		"codegen": "bun run kysely && bun run protoc",
		"pwa:generate": "pwa-assets-generator && pwa-assets-generator -c pwa-favicon.config.ts",
		"better-auth-migrate": "bunx @better-auth/cli@latest migrate"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"daisyui": "^5.7.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"knip": "^6.32.2",
		"kysely-codegen": "^0.20.0",
		"pg": "^8.22.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"protoc": "^34.2.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"ts-proto": "^2.12.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6",
		"vite-plugin-pwa": "^1.3.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1095.0",
		"@aws-sdk/s3-request-presigner": "^3.1095.0",
		"@better-auth/api-key": "^1.7.1",
		"@better-auth/utils": "^0.5.0",
		"@bufbuild/protobuf": "^2.13.0",
		"@imgproxy/imgproxy-node": "^1.1.0",
		"@mdi/js": "^7.4.47",
		"@types/bun": "^1.4.0",
		"@types/hammerjs": "^2.0.46",
		"@types/mime-types": "^3.0.1",
		"@types/pg": "^8.20.0",
		"better-auth": "^1.7.1",
		"hammerjs": "^2.0.8",
		"kysely": "^0.28.17",
		"mdi-svelte": "^1.1.2",
		"mime-types": "^3.0.2",
		"nice-grpc": "^2.1.16",
		"nice-grpc-common": "^2.0.3",
		"pgvector": "^0.2.1",
		"postgres-interval": "^4.1.0",
		"svelte-adapter-bun": "^1.0.1",
		"temporal-polyfill": "^1.0.2",
		"vidstack": "^1.15.6"
	}
}
